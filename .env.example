# =============================================================================
# Autonomous Options Trading Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control. It is listed in .gitignore.

# -----------------------------------------------------------------------------
# 1. Database & Cache
# -----------------------------------------------------------------------------
# PostgreSQL connection string (PostgreSQL only - no SQLite)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/trading_platform

# Redis connection URL for WebSocket tick cache
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# 2. Fyers API v3 (Market Data - ONLY data source)
# -----------------------------------------------------------------------------
FYERS_CLIENT_ID=your_fyers_client_id_here
FYERS_SECRET_KEY=your_fyers_secret_key_here
FYERS_REDIRECT_URI=http://localhost:8000/api/v1/fyers/auth/callback

# -----------------------------------------------------------------------------
# 3. Kotak Neo (Execution - ONLY broker for order placement)
# -----------------------------------------------------------------------------
KOTAK_CONSUMER_KEY=your_kotak_consumer_key_here
KOTAK_MOBILE_NUMBER=your_kotak_mobile_number_here
KOTAK_UCC=your_kotak_ucc_here
KOTAK_MPIN=your_kotak_mpin_here
KOTAK_TOTP_SECRET=your_kotak_totp_secret_here

# -----------------------------------------------------------------------------
# 4. xAI Grok (AI Brain - financial news analysis ONLY)
# -----------------------------------------------------------------------------
XAI_API_KEY=xai-your_api_key_here
XAI_MODEL=grok-beta

# -----------------------------------------------------------------------------
# 5. Telegram Alerts
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
