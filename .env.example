# ==========================================
# 1. GENERAL SETTINGS
# ==========================================
ENVIRONMENT=development
DEBUG=1

# ==========================================
# 2. SECURITY & AUTH
# ==========================================
SECRET_KEY=generate_a_random_secure_string_here
JWT_SECRET=generate_another_random_secure_string_here
JWT_TTL_MINUTES=720
ADMIN_EMAIL=agaffoor68@gmail.com
ADMIN_PASSWORD=Abdul@222

# ==========================================
# 3. DATABASE & CACHE
# ==========================================
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/alphatrade
REDIS_URL=redis://localhost:6379/0

# ==========================================
# 4. FYERS API (MARKET DATA)
# ==========================================
FYERS_CLIENT_ID=YOUR_FYERS_CLIENT_ID
FYERS_SECRET_KEY=YOUR_FYERS_SECRET_KEY
FYERS_REDIRECT_URI=http://localhost:8000/api/v1/fyers/callback

# ==========================================
# 5. KOTAK NEO (ORDER EXECUTION)
# ==========================================
KOTAK_CONSUMER_KEY=YOUR_KOTAK_CONSUMER_KEY
KOTAK_TOTP_SECRET=YOUR_KOTAK_TOTP_SECRET
KOTAK_MOBILE_NUMBER=YOUR_KOTAK_MOBILE
KOTAK_MPIN=YOUR_KOTAK_MPIN
KOTAK_UCC=YOUR_KOTAK_UCC
KOTAK_ENVIRONMENT=prod

# ==========================================
# 6. xAI GROK (AI BRAIN)
# ==========================================
XAI_API_KEY=YOUR_GROK_API_KEY
XAI_MODEL=grok-beta

# ==========================================
# 7. URLS & CORS (CRITICAL FOR DEPLOYMENT)
# ==========================================
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# 8. FEATURE GATES
# ==========================================
ENABLE_LIVE_TRADING=0
ENABLE_PAPER_TRADING=1
ENABLE_ALGO_EXECUTION=0

# ==========================================
# 9. NOTIFICATIONS (OPTIONAL)
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=