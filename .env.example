# ==========================================
# 1. GENERAL SETTINGS
# ==========================================
ENVIRONMENT=production
DEBUG=0

# ==========================================
# 2. SECURITY & AUTH
# ==========================================
SECRET_KEY=generate_a_random_secure_string_here
JWT_SECRET=generate_another_random_secure_string_here
JWT_TTL_MINUTES=720
ADMIN_EMAIL=agaffoor68@gmail.com
ADMIN_PASSWORD=Abdul@222

# ==========================================
# 3. DATABASE & CACHE
# ==========================================
# PostgreSQL connection string (Render provides this automatically for managed PostgreSQL)
# Format: postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/alphatrade

# Redis connection URL (Render Redis or external)
# Format: redis://:password@host:port/db
REDIS_URL=redis://localhost:6379/0

# ==========================================
# 4. FYERS API v3 (MARKET DATA - ONLY data source)
# ==========================================
# Get from Fyers API Dashboard: https://myapi.fyers.in/
FYERS_CLIENT_ID=YOUR_FYERS_APP_ID
FYERS_SECRET_KEY=YOUR_FYERS_SECRET_KEY
# Must match exactly what's configured in Fyers Dashboard (including trailing slash)
FYERS_REDIRECT_URI=https://your-backend.onrender.com/api/v1/fyers/callback

# ==========================================
# 5. KOTAK NEO (ORDER EXECUTION - ONLY broker for orders)
# ==========================================
# Get from Kotak Neo Developer Portal
KOTAK_CONSUMER_KEY=YOUR_KOTAK_CONSUMER_KEY
KOTAK_CONSUMER_SECRET=YOUR_KOTAK_CONSUMER_SECRET
KOTAK_TOTP_SECRET=YOUR_KOTAK_TOTP_SECRET
KOTAK_MOBILE_NUMBER=YOUR_REGISTERED_MOBILE
KOTAK_MPIN=YOUR_MPIN
KOTAK_UCC=YOUR_UCC
KOTAK_ENVIRONMENT=prod

# ==========================================
# 6. xAI GROK (AI BRAIN - financial news analysis ONLY)
# ==========================================
XAI_API_KEY=YOUR_GROK_API_KEY
XAI_MODEL=grok-beta

# ==========================================
# 7. URLS & CORS (CRITICAL FOR DEPLOYMENT)
# ==========================================
# Backend URL (Render service URL)
BACKEND_URL=https://your-backend.onrender.com

# Frontend URL (Vercel deployment URL)
FRONTEND_URL=https://your-frontend.vercel.app

# CORS allowed origins (comma-separated, must include Vercel domain)
# For production: include your Vercel domain and any preview domains
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://*.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# 8. FEATURE GATES
# ==========================================
ENABLE_LIVE_TRADING=0
ENABLE_PAPER_TRADING=1
ENABLE_ALGO_EXECUTION=0

# ==========================================
# 9. NOTIFICATIONS (OPTIONAL)
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================
# 10. FYERS ADVANCED (OPTIONAL)
# ==========================================
# FYERS_REFRESH_SCRIPT=/path/to/refresh_script.py  # Optional script for auto token refresh
# FYERS_STATE=trading_platform_state  # OAuth2 state parameter

# ==========================================
# IMPORTANT NOTES FOR RENDER DEPLOYMENT:
# ==========================================
# 1. Render PostgreSQL: Add managed PostgreSQL, it will auto-inject DATABASE_URL
# 2. Render Redis: Add managed Redis, it will auto-inject REDIS_URL
# 3. FYERS_REDIRECT_URI must use HTTPS and match Fyers Dashboard exactly
# 4. ALLOWED_ORIGINS must include your Vercel domain and *.vercel.app for preview deployments
# 5. FYERS_CLIENT_ID and FYERS_SECRET_KEY from https://myapi.fyers.in/
# 6. Fyers tokens expire daily at 6:30 AM IST - manual re-login required or use refresh script
# 7. Render outbound IPs are dynamic - Fyers does NOT require IP whitelisting for data APIs
# 8. For WebSocket stability, ensure websockets==8.1+wsproto is used (in requirements.txt)